{
  "name": "tappler_customer_app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start --port 8082",
    "start:reset": "react-native start --port 8082 --reset-cache",
    "start:local": "APP_ENV=localhost react-native start --port 8082",
    "prestart": "pids=$(lsof -ti:8082 2>/dev/null); [ -n \"$pids\" ] && echo \"freeing port 8082 (pid $pids)\" && kill -9 $pids; exit 0",
    "android": "react-native run-android --port 8082",
    "android:release": "react-native run-android --port 8082 --mode release",
    "ios": "react-native run-ios --port 8082 --simulator 'iPhone 17 Pro'",
    "ios:pick": "react-native run-ios --port 8082 --list-devices",
    "ios:release": "react-native run-ios --port 8082 --mode Release",
    "pods": "react-native run-ios --only-pods",
    "pods:force": "react-native run-ios --only-pods --force-pods",
    "doctor": "react-native doctor",
    "clean": "react-native clean",
    "lint": "eslint .",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@lodev09/react-native-true-sheet": "3.11.14",
