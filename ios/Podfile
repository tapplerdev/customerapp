# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# react-native-permissions setup
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native-permissions/scripts/setup.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

setup_permissions([
  'LocationWhenInUse',
  'PhotoLibrary',
  'Camera',
])

# min_ios_version_supported now resolves to 15.1 — RN 0.76 raised its own floor
# (node_modules/react-native/scripts/cocoapods/helpers.rb). Left as the helper
# rather than hardcoded so it tracks RN automatically. proapp hardcodes '15.1';
# either is fine, this one self-updates.
platform :ios, min_ios_version_supported

# New Architecture pinned OFF. In 0.76 the DEFAULT is ON — new_architecture.rb's
# new_arch_enabled reads `ENV[...] == nil || == '1'`, so an UNSET var means ON.
# The :new_arch_enabled keyword below is the authoritative switch; this env line
# covers anything reading the flag before use_react_native! runs.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

prepare_react_native_project!

# NO global `use_modular_headers!`. RN 0.76's ReactCommon.podspec:35 sets
# `s.header_dir = "ReactCommon"` (its own comment says "for use_frameworks!
# compatibility"), and React-RuntimeApple shares that header dir. With a GLOBAL
# modular-headers flag and no use_frameworks!, CocoaPods writes one modulemap
# per pod into Pods/Headers/Public/ReactCommon/ and BOTH declare
# `module ReactCommon`, so every target that imports it dies with:
#   Pods/Headers/Public/ReactCommon/ReactCommon.modulemap:1:8:
#     error: Redefinition of module 'ReactCommon'
# and then a cascade of bogus "Could not build module 'CoreFoundation'" noise
# that looks like a corrupt module cache but is not.
# The pods that genuinely need modular headers (Firebase and friends) already
# declare `:modular_headers => true` individually below, so nothing is lost.
# proapp avoids this instead by using `use_frameworks! :linkage => :static`,
# which gives every pod its own framework module — a valid alternative, but a
# far larger change to linkage than this.

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'tappler_customer_app' do
  config = use_native_modules!

  # React Native Maps - Google Maps provider
  rn_maps_path = '../node_modules/react-native-maps'
  pod 'react-native-google-maps', :path => rn_maps_path

  # Firebase modular headers (required for Swift pods)
  pod 'Firebase', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # New arch off, belt to the ENV line's braces. use_react_native! runs
    # ENV['RCT_NEW_ARCH_ENABLED'] = compute_new_arch_enabled(...), so this
    # keyword beats even an externally-set RCT_NEW_ARCH_ENABLED=1.
    :new_arch_enabled => false,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'tappler_customer_appTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Customer app's Metro runs on 8082 (proapp uses the default 8081). RCT_METRO_PORT
    # is compiled into React-Core (RCTBundleURLProvider), so set it here as a build
    # setting — the debug bundle URL then resolves to :8082 with no AppDelegate hack.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['RCT_METRO_PORT'] = '8082'

        # Some pods still declare an iOS floor below ours, which Xcode 16+ warns
        # about loudly and, for a few, errors on. Clamp anything lower up to the
        # project's minimum.
        target_version = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if target_version && Gem::Version.new(target_version) < Gem::Version.new('15.1')
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end
  end
end
